[gd_scene format=3]

[node name="RendererAssets" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "MESHES / MATERIAL SLOTS"
theme_override_colors/font_color = Color(0.83, 0.66, 0.35, 1)

[node name="Entries" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AddEntry" type="Button" parent="."]
layout_mode = 2
text = "Add mesh entry"

[node name="SlotsTitle" type="Label" parent="."]
layout_mode = 2
text = "SURFACE MATERIALS"
theme_override_colors/font_color = Color(0.83, 0.66, 0.35, 1)

[node name="Slots" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="AddSlot" type="Button" parent="."]
layout_mode = 2
text = "Add material slot"

[node name="Note" type="Label" parent="."]
layout_mode = 2
text = "Slot parameters take precedence over slot materials and the all-surface override. Imported source paths are preserved. Execution diagnostics still report unsupported configurations."
autowrap_mode = 3
theme_override_font_sizes/font_size = 11
