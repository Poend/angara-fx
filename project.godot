config_version=5

[application]
config/name="Angara FX"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://examples/embers/embers.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540

[editor]
export/convert_text_resources_to_binary=false

[editor_plugins]
enabled=PackedStringArray("res://addons/niagara_bridge/plugin.cfg")

[physics]
3d/physics_engine="Jolt Physics"
